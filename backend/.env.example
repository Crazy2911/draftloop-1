# Copy this file to .env and add your own Groq API key.
GROQ_API_KEY=GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Relative paths resolve inside backend/
DATABASE_PATH=draftloop.db

# Grading limits
MAX_ESSAY_CHARACTERS=30000
GROQ_TIMEOUT_SECONDS=90